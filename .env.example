# База данных PostgreSQL + pgvector
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=taires_db
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/taires_db

# Брокер и кэш Redis
REDIS_URL=redis://localhost:6379/0

# JWT и безопасность
SECRET_KEY=change-me-in-production-use-at-least-32-chars-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Межсервисный обмен "Две таблицы + токен" (Сервер <-> Сервер, запускающий ИИ)
AI_SERVICE_TOKEN=dev-ai-service-secret-token
EXTERNAL_AI_SERVER_URL=

# Хранилище S3 / MinIO с нейросетями (tAIres-Trainer -> S3 -> Сервер ИИ)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MODELS=taires-models
S3_REGION=us-east-1

# ML-модель и параметры сопоставления (Bi-Encoder)
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
HF_HOME=/models
MATCH_BATCH_SIZE=50
MATCH_TOP_K=15
MATCH_AUTO_THRESHOLD=0.85
MATCH_REVIEW_THRESHOLD=0.70

# Интеграция с 1С / ERP (Webhook)
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=change-me-erp-webhook-hmac-secret
ERP_WEBHOOK_TIMEOUT_SECONDS=15
